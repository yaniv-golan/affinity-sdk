{
  "name": "affinity-crm-cli-xaffinity-unofficial",
  "description": "Affinity CRM command-line tools — search contacts, export lists to CSV, filter pipelines, and manage CRM data via xaffinity",
  "version": "1.10.0",
  "author": {
    "name": "Yaniv Golan",
    "email": "yaniv@golan.name"
  },
  "homepage": "https://yaniv-golan.github.io/affinity-sdk/",
  "repository": "https://github.com/yaniv-golan/affinity-sdk",
  "license": "MIT",
  "keywords": [
    "affinity",
    "crm",
    "cli",
    "xaffinity",
    "export",
    "csv"
  ],
  "skills": [
    "./skills"
  ],
  "hooks": [
    "./hooks/hooks.json"
  ],
  "clis": {
    "xaffinity": {
      "displayName": "Affinity CRM",
      "network": ["api.affinity.co"],
      "env": {
        "api_key": {
          "envVar": "AFFINITY_API_KEY",
          "secret": true,
          "displayName": "Affinity API Key",
          "description": "From Affinity Settings → API Keys"
        }
      }
    }
  }
}
