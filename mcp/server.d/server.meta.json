        "MCPBASH_PROJECT_ROOT": "${__dirname}/server",
        "MCPBASH_TOOL_ALLOWLIST": "*",
        "MCPBASH_STATIC_REGISTRY": "1",
        "AFFINITY_API_KEY": "${user_config.api_key}",
        "AFFINITY_MCP_READ_ONLY": "${user_config.read_only}",
